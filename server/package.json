{
  "name": "pockets-signaling-server",
  "version": "1.0.0",
  "description": "WebSocket signaling server for Pockets WebRTC app",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "build:tsc": "tsc --noEmit",
    "test": "tsx --test src/services/socket.service.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pockets/shared": "workspace:*",
    "dotenv": "^17.2.3",
    "redis": "^5.10.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@types/webrtc": "^0.0.46",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
