{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "pockets-render-keepalive",
  "main": "src/index.mjs",
  "compatibility_date": "2025-11-24",
  "workers_dev": false,
  "triggers": {
    "crons": ["*/12 * * * *"]
  },
  "vars": {
    "HEALTH_URL": "https://pockets-kyb4.onrender.com/health"
  },
  "observability": {
    "enabled": true
  }
}
