{
  "name": "pockets-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter pockets-ui dev",
    "dev:server": "pnpm --filter pockets-signaling-server dev",
    "build:shared": "pnpm --filter @pockets/shared build",
    "build:server": "pnpm --filter @pockets/shared build && pnpm --filter pockets-signaling-server build",
    "build:frontend": "pnpm --filter @pockets/shared build && pnpm --filter pockets-ui build",
    "start:server": "pnpm --filter pockets-signaling-server start",
    "start:frontend": "pnpm --filter pockets-ui start",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "next": "15.4.10"
  }
}
