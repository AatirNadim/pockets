# Frontend Environment Variables

# Browser-reachable signaling hostname:port (or prefix with ws:// or wss://)
# For local development: localhost:8080
# For mDNS/Caddy setup: yourhostname.local:8443
NEXT_PUBLIC_SERVER_PATH=localhost:8080

# Canonical public origin for metadata and sitemap. Production defaults to
# https://pockets.aatirnadim.dev; local development defaults to localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://pockets.aatirnadim.dev

# ------------------------------------------------------------------------------
# Optional TURN / ICE Server Configuration (server-side only; never prefix with NEXT_PUBLIC_)
# Configure one or more of the options below for NAT traversal in production:
# ------------------------------------------------------------------------------

# Option 1: External TURN credential service (e.g. Cloudflare TURN, Metered, Twilio NTS)
# Supports responses shaped as { "iceServers": [...] } or a top-level [...] array.
# TURN_CREDENTIALS_URL=https://turn-provider.example/api/credentials
# TURN_CREDENTIALS_TOKEN=replace-with-a-server-side-token
# TURN_CREDENTIALS_METHOD=GET
# TURN_CREDENTIALS_TTL_SECONDS=86400

# Option 2: Direct TURN server URLs (comma-separated) with coturn shared secret (HMAC-SHA1)
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-coturn-static-auth-secret
# TURN_CREDENTIAL_TTL_SECONDS=3600

# Option 3: Direct TURN server URLs (comma-separated) with static username & credential
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=replace-with-turn-username
# TURN_CREDENTIAL=replace-with-turn-credential

# Option 4: Raw JSON array of RTCIceServer objects (or { "iceServers": [...] })
# TURN_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478","turns:turn.example.com:5349?transport=tcp"],"username":"user","credential":"secret"}]
