# Frontend Environment Variables

# Server hostname:port for WebSocket connection
# For local development: localhost:8080
# For mDNS/Caddy setup: yourhostname.local:8443
NEXT_PUBLIC_SERVER_PATH=localhost:8080

# Canonical public origin for metadata and sitemap (set this on the deployment).
# Vercel deployments use VERCEL_URL automatically when this is unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional server-to-server endpoint that returns short-lived ICE/TURN credentials
# The response format is { "iceServers": [{ "urls": "turns:...", "username": "...", "credential": "..." }] }
# Keep its API token private; never put TURN credentials in NEXT_PUBLIC variables.
# TURN_CREDENTIALS_URL=https://turn-provider.example/api/credentials
# TURN_CREDENTIALS_TOKEN=replace-with-a-server-side-token
